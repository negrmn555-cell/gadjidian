# ---------- server ----------
PORT=8080
# Public address of the app (used in CLI hints)
PUBLIC_URL=https://notes.example.com
# Domain for Caddy (docker-compose)
DOMAIN=notes.example.com
# Secret for /api/admin/* (optional; CLI works without it)
ADMIN_SECRET=
# Set to false only for local development in a normal browser tab
REQUIRE_STANDALONE=true
LOG_LEVEL=info

# ---------- vault ----------
# Local dev: absolute path to a vault copy. In Docker it's /data/vault (leave empty).
VAULT_PATH=
VAULT_INBOX=Inbox
VAULT_DAILY_FOLDER=Daily
VAULT_DAILY_FORMAT=YYYY-MM-DD
# Optional: template note for new daily notes, e.g. Templates/Daily.md
VAULT_DAILY_TEMPLATE=
# Heading under which quick lines are appended, e.g. "## Заметки" (empty = end of file)
VAULT_DAILY_SECTION=
# Optional: template for new notes ({{title}}, {{content}}, {{date}}, {{time}})
VAULT_NOTE_TEMPLATE=
# Comma-separated folders the assistant must never read/write
VAULT_PRIVATE_FOLDERS=Private,Journal

# ---------- LLM (OpenAI-compatible) ----------
# OpenRouter: https://openrouter.ai/api/v1   OpenAI: https://api.openai.com/v1   Ollama: http://ollama:11434/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-...
LLM_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0.3
# Existing LLM_* configuration is imported into settings once.
# Optional: 32 random bytes encoded as base64. Keep outside the database/vault.
# If empty, the server creates DATA_DIR/secrets/provider-master.key (persist it separately).
PROVIDER_MASTER_KEY=
# Exact origins for trusted local APIs. Leave empty to allow only public HTTPS endpoints.
# Example: http://ollama:11434
PROVIDER_ALLOWED_ORIGINS=
PROVIDER_TIMEOUT_MS=60000
# Agent engine is fixed when a request starts. Switch to legacy for new runs only.
AGENT_ENGINE=mastra
# Includes the final answer step; allowed range 2..6.
AGENT_MAX_STEPS=4
# Contact used in Web Push VAPID claims. This is not an SMS gateway.
WEB_PUSH_SUBJECT=mailto:you@example.com
# ---------- sync ----------
# none | git
SYNC_MODE=git
# SSH remote of the vault repo (the PC pushes here via obsidian-git)
GIT_REMOTE=git@github.com:you/obsidian-vault.git
GIT_BRANCH=main
GIT_AUTHOR_NAME=obsidian-relay
GIT_AUTHOR_EMAIL=relay@localhost
# seconds between background pulls; read-only chat requests use the local revision
SYNC_PULL_INTERVAL=120
# maximum age of the last successful pull before a write (milliseconds)
SYNC_FRESHNESS_MS=30000
# timeout of a Git command (milliseconds)
GIT_TIMEOUT_MS=30000
# seconds to wait after a write before commit+push
SYNC_PUSH_DEBOUNCE=5
# Container CPU quota. Default fits a one-CPU VPS.
RELAY_CPUS=1

# ---------- metadata-only diagnostics ----------
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Explicit local collector origins, if needed. Never used as a redirect allowlist.
LANGFUSE_ALLOWED_ORIGINS=
# Also configure this retention policy in the Langfuse project itself.
LANGFUSE_RETENTION_DAYS=14
# Read-only MCP endpoint. Separate revocable keys are created in Settings.
MCP_ENABLED=true
